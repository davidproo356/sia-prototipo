# Plantilla para entorno local (copiar a .env, nunca subir .env)
COMPOSE_PROJECT_NAME=sia-prototipo
TZ=America/Lima
DB_NAME=sia_prototipo
DB_USER=sia_local
DB_PASSWORD=REEMPLAZAR_CON_CLAVE_LOCAL_SEGURA
DB_PORT=5433
DB_BIND_IP=127.0.0.1

# Reservados para cuando se desarrollen backend/ y ai/
BACKEND_PORT=8080
BACKEND_BIND_IP=127.0.0.1
AI_PORT=8000
AI_BIND_IP=127.0.0.1
